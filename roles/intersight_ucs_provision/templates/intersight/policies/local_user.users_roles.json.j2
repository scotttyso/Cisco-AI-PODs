{
  "Enabled": {{ item.enabled | default(true) | tojson }},
  "EndPointRole": [
    {
      "Moid": "{{ isight['system']['iam_end_point_role'][item.role | default('readonly')].moid }}",
      "ObjectType": "iam.EndPointRole"
    }
  ],
{% set _policy = isight[organization]['policies']['local_user'][item.parent] %}
  "EndPointUser": {
    "Moid": "{{ isight[organization]['policies']['local_user'][_policy]['users'][item.name].moid }}",
    "ObjectType": "iam.EndPointUser"
  },
  "EndPointUserPolicy": {
    "Moid": "{{ item.parent }}",
    "ObjectType": "iam.EndPointUserPolicy"
  },
  "ObjectType": "iam.EndPointUserRole",
  "Password": {{ sensitive_vars['local_user_password_' ~ item.password | default(1)] | tojson }},
  "Parent": {
    "Moid": "{{ item.parent }}",
    "ObjectType": "iam.EndPointUserPolicy"
  }
}