{
  "Description": {{ item.description | default('') | tojson }},
  "Name": {{ (name_prefix ~ item.name ~ name_suffix) | tojson }},
  "ObjectType": "compute.PcieConnectivityPolicy",
  "Organization": {
    "Moid": {{ org_moids[organization].moid | tojson }},
    "ObjectType": "organization.Organization"
  },
  "PcieZones": [
{% for mapping in item.mappings %}
    {
      "ObjectType": "compute.PcieZone",
      "PcieEndpoints": [
        {
          "GpuPropFilters": [
            {
              "Count": {{ mapping.gpu_quantity | default(1) | tojson }},
              "Model": {{ item.gpu_model | default('Any') | tojson }},
              "ObjectType": "compute.GpuPropFilter"
            }
          ],
          "ObjectType": "compute.GpuConfig",
          "PcieEndpointType": "GPU"
        }{% if mapping.smart_nic is defined %},
        {
          "AdapterUnitPropFilters": [
            {
              "Count": 1,
              "Model": {{ mapping.smart_nic | tojson }},
              "ObjectType": "compute.AdapterUnitPropFilter"
            }
          ],
          "ObjectType": "compute.AdapterUnitConfig",
          "PcieEndpointType": "Adapter"
        }
{% endif %}
      ],
      "RootPcieEndpoint": {
        "CpuId": {{ ('Any' if mapping.cpu_id == 'any' else mapping.cpu_id | string) | tojson }},
        "ObjectType": "compute.CpuConfig",
        "RootPcieEndpointType": "CPU"
      }
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "Tags": [
{% for tag in item.tags %}
    {
      "Key": {{ tag.key | tojson }},
{% if tag.type | default(tag.tag_type | default('KeyValue')) == 'PathTag' %}
      "Type": "PathTag"
{% else %}
      "Type": "KeyValue",
      "Value": {{ tag.value | tojson }}
{% endif %}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
