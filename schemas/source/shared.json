{
    "$id": "shared.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "definitions": {
        "dns_1123_label": {
            "default": "example",
            "description": "The default value is `example`.  Most Objects (Namespaces, Pods, Services, Routes): OpenShift Limits this to 49 characters max.",
            "examples": [
                "example",
                "subexample"
            ],
            "maxLength": 49,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "title": "DNS 1123 Label",
            "type": "string"
        },
        "dns_1123_subdomain": {
            "default": "subexample",
            "description": "The default value is `subexample`.  Most Objects (Namespaces, Pods, Services, Routes): OpenShift Limits this to 253 characters max.",
            "examples": [
                "example",
                "subexample"
            ],
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "title": "DNS 1123 Subdomain",
            "type": "string"
        },
        "dns_search_domains": {
            "description": "List of Domain Names.",
            "items": {
                "$ref": "#/definitions/domain_name"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Domain Names",
            "type": "array",
            "uniqueItems": true
        },
        "dns_servers": {
            "items": {
                "default": "208.67.220.220",
                "description": "The default value is `208.67.220.220`.  DNS Server.",
                "examples": [
                    "208.67.220.220",
                    "8.8.8.8",
                    "2001:db8::1"
                ],
                "maxLength": 39,
                "minLength": 6,
                "pattern": "^(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6})))$",
                "title": "DNS Server",
                "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "DNS Servers",
            "type": "array",
            "uniqueItems": true
        },
        "domain_name": {
            "default": "example.com",
            "description": "The default value is `example.com`.  Domain Name.",
            "examples": [
                "example.com",
                "sub.example.com"
            ],
            "maxLength": 200,
            "minLength": 4,
            "pattern": "^((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6}$",
            "title": "Domain Name",
            "type": "string"
        },
        "file_path": {
            "examples": [
                "/home/blah/downloads/certificate.pem"
            ],
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?:(?:/(?:[^\\0/]+/)*[^\\0/]+)|(?:[A-Za-z]:[\\\\/](?:[^<>:\"|?*\\r\\n]+[\\\\/])*[^<>:\"|?*\\r\\n]+)|(?:\\.{1,2}[\\\\/])?(?:[^<>:\"|?*\\r\\n\\\\/]+[\\\\/])*[^<>:\"|?*\\r\\n\\\\/]+)$",
            "type": "string"
        },
        "hostname": {
            "examples": [
                "server.example.com"
            ],
            "maxLength": 255,
            "minLength": 7,
            "pattern": "(?=^.{1,255}$)(^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$)",
            "type": "string"
        },
        "hostname_ipv4_or_ipv6": {
            "examples": [
                "server.example.com",
                "198.18.0.1",
                "2001:db8::1"
            ],
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))|((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6})$",
            "type": "string"
        },
        "ip": {
            "additionalProperties": false,
            "description": "Dictionary of IP address types.",
            "properties": {
                "ipv4_address": {
                    "examples": [
                        "198.18.0.1"
                    ],
                    "maxLength": 15,
                    "minLength": 7,
                    "pattern": "^(([1-9]|[1-9][0-9]{1}|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.)(([01]?[0-9]?[0-9]|2([0-4][0-9]|5[0-5]))\\.){2}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
                    "type": "string"
                },
                "ipv4_netmask": {
                    "examples": [
                        "255.255.255.0"
                    ],
                    "maxLength": 15,
                    "minLength": 7,
                    "pattern": "^(([1-9]|[1-9][0-9]{1}|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.)(([01]?[0-9]?[0-9]|2([0-4][0-9]|5[0-5]))\\.){2}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
                    "type": "string"
                },
                "ipv4_network": {
                    "examples": [
                        "198.18.0.0/24"
                    ],
                    "maxLength": 18,
                    "minLength": 9,
                    "pattern": "^(([1-9]|[1-9][0-9]{1}|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.)(([01]?[0-9]?[0-9]|2([0-4][0-9]|5[0-5]))\\.){2}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\/(?:3[0-2]|[0-2]?\\d))$",
                    "type": "string"
                },
                "ipv4_or_ipv6_address": {
                    "examples": [
                        "198.18.0.1",
                        "2001:db8::1"
                    ],
                    "maxLength": 39,
                    "minLength": 3,
                    "pattern": "^(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6})))$",
                    "type": "string"
                },
                "ipv4_or_ipv6_network": {
                    "examples": [
                        "198.18.0.0/24",
                        "2001:db8::/64"
                    ],
                    "maxLength": 43,
                    "minLength": 3,
                    "pattern": "^(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}(?:\\/(?:3[0-2]|[0-2]?\\d))?|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))(?:\\/(?:12[0-8]|1[0-1][0-9]|\\d{1,2}))?)$",
                    "type": "string"
                },
                "ipv6_address": {
                    "examples": [
                        "2001:db8::1"
                    ],
                    "maxLength": 39,
                    "minLength": 3,
                    "pattern": "^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))$",
                    "type": "string"
                },
                "ipv6_network": {
                    "examples": [
                        "2001:db8::/64"
                    ],
                    "maxLength": 43,
                    "minLength": 3,
                    "pattern": "^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))(?:\\/(?:12[0-8]|1[0-1][0-9]|\\d{1,2}))$",
                    "type": "string"
                },
                "ipv6_prefix": {
                    "examples": [
                        64
                    ],
                    "maximum": 128,
                    "minimum": 1,
                    "type": "integer"
                }
            },
            "title": "IP Address Types",
            "type": "object"
        },
        "mac_address": {
            "examples": [
                "00:1e:67:8c:9b:11",
                "00:25:B5:0A:00:00"
            ],
            "maxLength": 17,
            "minLength": 17,
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
            "type": "string"
        },
        "ntp_servers": {
            "description": "List of NTP Servers.",
            "items": {
                "default": "0.pool.ntp.org",
                "description": "The default value is `0.pool.ntp.org`.  NTP Server.",
                "examples": [
                    "0.pool.ntp.org",
                    "1.pool.ntp.org"
                ],
                "maxLength": 255,
                "minLength": 3,
                "pattern": "^(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))|((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6})$",
                "title": "NTP Server",
                "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "NTP Servers",
            "type": "array",
            "uniqueItems": true
        },
        "proxy_servers": {
            "allOf": [
                {
                    "additionalProperties": false,
                    "properties": {
                        "http_proxy": {
                            "default": "http://proxy.example.com:8080",
                            "description": "The default value is `http://proxy.example.com:8080`.  The HTTP proxy server to use.\n\nThis is optional, but if you have a proxy server, you can set it here.",
                            "examples": [
                                "http://proxy.example.com:8080"
                            ],
                            "maxLength": 266,
                            "minLength": 1,
                            "pattern": "^(?:http[s]?:\\/\\/)(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))(?:\\/(?:12[0-8]|1[0-1][0-9]|\\d{1,2}))?|((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6})(:(\\d{1,5}))$",
                            "title": "HTTP Proxy Server",
                            "type": "string"
                        },
                        "https_proxy": {
                            "default": "http://proxy.example.com:8080",
                            "description": "The default value is `http://proxy.example.com:8080`.  The HTTPS proxy server to use.\n\nThis is optional, but if you have a proxy server, you can set it here.",
                            "examples": [
                                "http://proxy.example.com:8080",
                                "https://proxy.example.com:8080"
                            ],
                            "maxLength": 266,
                            "minLength": 1,
                            "pattern": "^(?:http[s]?:\\/\\/)(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))(?:\\/(?:12[0-8]|1[0-1][0-9]|\\d{1,2}))?|((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6})(:(\\d{1,5}))$",
                            "title": "HTTPS Proxy Server",
                            "type": "string"
                        },
                        "no_proxy": {
                            "description": "List of Bypass URL's or IP addresses/networks to exclude from proxying.\n\nFor `no_proxy`, related to OpenShift, we recommend including the following at a minimum:\n\n  * `localhost`\n  * `.cluster.local`\n  * `.svc.cluster.local`\n  * `apps.<cluster_name>.<base_dns_domain>`\n  * `.<cluster_name>.<base_dns_domain>`\n  * `.<base_dns_domain>`",
                            "items": {
                                "default": "",
                                "description": "The default value is ``.  Bypass URL.",
                                "examples": [
                                    "example.com",
                                    ".example.com",
                                    "127.0.0.1",
                                    "198.18.0.0/16",
                                    "::1",
                                    "2001:db8::/32"
                                ],
                                "maxLength": 512,
                                "minLength": 3,
                                "pattern": "^localhost|(((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}(?:\\/(?:3[0-2]|[0-2]?\\d))?|((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))(?:\\/(?:12[0-8]|1[0-1][0-9]|\\d{1,2}))?|(\\.)?((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+[A-Za-z]{2,6})$",
                                "title": "Bypass URL",
                                "type": "string"
                            },
                            "maxItems": 100,
                            "minItems": 1,
                            "title": "Bypass URLs",
                            "type": "array",
                            "uniqueItems": true
                        },
                        "password": {
                            "default": 1,
                            "description": "The default value is `1`.  The Proxy Password Sensitive Variable Identifier.  Only required if proxy requires authentication.  A number Between 1-64 to denote the variables proxy_password_[1-64].  i.e. `export proxy_password_1='cisco123'`.",
                            "maximum": 64,
                            "minimum": 1,
                            "title": "Proxy Password",
                            "type": "integer"
                        },
                        "username": {
                            "default": "",
                            "description": "The default value is ``.  Username for Proxy Authentication.  Only required if proxy requires authentication.",
                            "examples": [
                                "proxy_username"
                            ],
                            "maxLength": 64,
                            "minLength": 1,
                            "pattern": "^.{1,128}$",
                            "title": "Proxy Username",
                            "type": "string"
                        }
                    },
                    "required": [],
                    "type": "object"
                }
            ],
            "description": "This dictionary provides the required configuration settings for the network proxy settings.\n\nOptional fields are:\n  * `http_server`\n  * `https_server`\n  * `no_proxy`\n  * `password`\n  * `username`",
            "title": "OpenShift Container Platform (OCP) - Machine Network Gateway",
            "unevaluatedProperties": false
        },
        "ssh_public_key": {
            "default": 1,
            "description": "The default value is `1`.  SSH public key to assign.  A number Between 1-64 to denote the variables ssh_public_key_[1-64].  i.e. `export ssh_public_key_1='ssh-ed25519 AAAAC...'`.",
            "maximum": 64,
            "minimum": 1,
            "title": "SSH Public Key",
            "type": "integer"
        },
        "timezone": {
            "default": "UTC",
            "description": "The default value is `UTC`.  The timezone of the node's system clock.",
            "enum": [
                "Africa/Abidjan",
                "Africa/Accra",
                "Africa/Addis_Ababa",
                "Africa/Algiers",
                "Africa/Asmara",
                "Africa/Bamako",
                "Africa/Bangui",
                "Africa/Banjul",
