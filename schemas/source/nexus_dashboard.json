{
    "$id": "nexus_dashboard.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "definitions": {
        "cluster": {
            "additionalProperties": false,
            "description": "Settings applied to the ND cluster as a whole.\n\nRequired Attributes:\n  * `dns`\n  * `iso`\n  * `name`\n  * `network`\n  * `ntp`\n  * `persistent_ips`\n\nOptional Attributes:\n  * `implementation_type` - Default is `LAN`.\n  * `proxy`\n  * `timezone`",
            "properties": {
                "dns": {
                    "$ref": "#/definitions/cluster.dns",
                    "description": "DNS resolvers used by the cluster (Table 1: <dns_server_*>, <dns_search_domain>)."
                },
                "implementation_type": {
                    "default": "LAN",
                    "description": "ND implementation type. AI POD CVDs use LAN.",
                    "enum": [
                        "Fabric",
                        "LAN"
                    ],
                    "type": "string"
                },
                "iso": {
                    "$ref": "#/definitions/cluster.iso",
                    "description": "ND ISO image hosted on a server reachable from each node's CIMC."
                },
                "name": {
                    "description": "Cluster name (Table 1: <cluster_name>). Letters, digits, hyphens; must start with a letter.",
                    "maxLength": 63,
                    "minLength": 1,
                    "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                    "type": "string"
                },
                "network": {
                    "$ref": "#/definitions/cluster.network",
                    "description": "L3 network parameters shared by all nodes. Per-node IPs are inside the nodes array."
                },
                "ntp": {
                    "$ref": "#/definitions/cluster.ntp",
                    "description": "NTP servers used by the cluster (Table 1: <ntp_server_*>). Two or more required by the MOP prereqs."
                },
                "persistent_ips": {
                    "description": "Persistent IP pool for service endpoints (Table 1: <persistent_ip_start>-<persistent_ip_end>). MOP prerequisites require at least 5 values.\n\nRequired Attributes:\n  * `persistent_ips`\n\nOptional Attributes:\n  * None",
                    "items": {
                        "$ref": "./shared.json#/definitions/ip/properties/ipv4_address"
                    },
                    "minItems": 5,
                    "type": "array",
                    "uniqueItems": true
                },
                "proxy": {
                    "$ref": "./shared.json#/definitions/proxy_servers",
                    "description": "Outbound HTTP(S) proxy. Set skip:true to disable; otherwise url is required."
                },
                "runtime": {
                    "$ref": "#/definitions/cluster.runtime",
                    "description": "Runtime environment for the cluster."
                },
                "timezone": {
                    "$ref": "./shared.json#/definitions/timezone"
                }
            },
            "required": [
                "dns",
                "iso",
                "name",
                "network",
                "ntp",
                "persistent_ips"
            ],
            "type": "object"
        },
        "cluster.dns": {
            "additionalProperties": false,
            "description": "DNS resolvers used by the cluster (Table 1: <dns_server_*>, <dns_search_domain>).\n\nRequired Attributes:\n  * `servers`\n\nOptional Attributes:\n  * `search_domains`",
            "properties": {
                "search_domains": {
                    "$ref": "./shared.json#/definitions/dns_search_domains"
                },
                "servers": {
                    "$ref": "./shared.json#/definitions/dns_servers"
                }
            },
            "required": [
                "servers"
            ],
            "type": "object"
        },
        "cluster.iso": {
            "additionalProperties": false,
            "description": "ND ISO image hosted on a server reachable from each node's CIMC.\n\nRequired Attributes:\n  * `sha512`\n  * `url`\n\nOptional Attributes:\n  * `file_path`",
            "properties": {
                "file_path": {
                    "$ref": "./shared.json#/definitions/file_path",
                    "description": "ISO file path relative to the server URL (Table 1: <iso_file_location>). HTTP/HTTPS reachable from each CIMC vMedia."
                },
                "sha512": {
                    "description": "Vendor-published SHA-512 of the ISO. Pre-flight verifies the served file matches.",
                    "maxLength": 128,
                    "minLength": 128,
                    "pattern": "^[a-fA-F0-9]{128}$",
                    "title": "SHA-512 of the ISO",
                    "type": "string"
                },
                "url": {
                    "$ref": "./shared.json#/definitions/http_or_https_url",
                    "description": "ISO URL (Table 1: <iso_url>). HTTP/HTTPS reachable from each CIMC vMedia."
                }
            },
            "required": [
                "sha512",
                "url"
            ],
            "type": "object"
        },
        "cluster.network": {
            "additionalProperties": false,
            "description": "L3 network parameters shared by all nodes. Per-node IPs are inside the nodes array.\n\nRequired Attributes:\n  * `data_gateway`\n  * `data_subnet`\n  * `mgmt_gateway`\n  * `mgmt_subnet`\n\nOptional Attributes:\n  * None",
            "properties": {
                "data_gateway": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Default gateway on ND-DATA (Table 1: <data_gateway>)."
                },
                "data_subnet": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_network",
                    "description": "ND data subnet. L2 mode requires persistent IPs in this subnet."
                },
                "mgmt_gateway": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Default gateway on ND-MGMT (Table 1: <mgmt_gateway>)."
                },
                "mgmt_subnet": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_network",
                    "description": "ND management subnet (Table 1: <mgmt_prefix> applied)."
                }
            },
            "required": [
                "data_gateway",
                "data_subnet",
                "mgmt_gateway",
                "mgmt_subnet"
            ],
            "type": "object"
        },
        "cluster.nodes": {
            "allOf": [
                {
                    "contains": {
                        "properties": {
                            "role": {
                                "const": "bootstrap"
                            }
                        }
                    },
                    "description": "Exactly one node must be role=bootstrap.",
                    "maxContains": 1,
                    "minContains": 1
                }
            ],
            "description": "Exactly 3 ND nodes. Subsystem 01 currently scopes a 3-node primary cluster; standby/secondary scaling is out of scope until ND adds it to AI POD.\n\nRequired item attributes:\n  * `cimc`\n  * `data`\n  * `hostname`\n  * `mgmt`\n  * `role`\n  * `type`\n\nOptional item attributes:\n  * None",
            "items": {
                "$ref": "#/definitions/cluster.nodes.node"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
        },
        "cluster.nodes.node": {
            "additionalProperties": false,
            "description": "Configuration for a single Nexus Dashboard node.\n\nRequired Attributes:\n  * `cimc`\n  * `data`\n  * `hostname`\n  * `mgmt`\n  * `role`\n  * `type`\n\nOptional Attributes:\n  * None",
            "properties": {
                "cimc": {
                    "$ref": "#/definitions/cluster.nodes.node.cimc",
                    "description": "Out-of-band CIMC management for this chassis (Credentials table: CIMC admin)."
                },
                "data": {
                    "$ref": "#/definitions/cluster.nodes.node.data",
                    "description": "ND-DATA (cluster data plane) interface for this node."
                },
                "hostname": {
                    "description": "Node hostname (Table 2: <ndN_hostname>). Lowercase letters, digits, hyphens; must start with a letter. Convention is nd-1, nd-2, nd-3.",
                    "maxLength": 63,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "type": "string"
                },
                "mgmt": {
                    "$ref": "#/definitions/cluster.nodes.node.mgmt",
                    "description": "ND-MGMT (out-of-band cluster mgmt) interface for this node."
                },
                "role": {
                    "description": "Phase 1 automation role. Exactly one node has role=bootstrap (nd-1, runs Redfish + SOL install path); the other two are role=secondary (ND drives their install via cluster bringup API).",
                    "enum": [
                        "bootstrap",
                        "secondary"
                    ],
                    "type": "string"
                },
                "type": {
                    "description": "ND node type. AI POD always uses Primary for all 3 nodes.",
                    "enum": [
                        "Primary"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "cimc",
                "data",
                "hostname",
                "mgmt",
                "role",
                "type"
            ],
            "type": "object"
        },
        "cluster.nodes.node.cimc": {
            "additionalProperties": false,
            "description": "Out-of-band CIMC management for this chassis (Credentials table: CIMC admin).",
            "properties": {
                "ip": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "CIMC IP (Table 2: <nd_cimc_ip>)."
                },
                "username": {
                    "default": "admin",
                    "description": "CIMC user (Table 1: <cimc_user>, typically admin).  Username (admin, oper, svc-...). No whitespace; no shell metacharacters.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+$",
                    "type": "string"
                }
            },
            "required": [
                "ip"
            ],
            "type": "object"
        },
        "cluster.nodes.node.data": {
            "additionalProperties": false,
            "description": "ND-DATA (cluster data plane) interface for this node.",
            "properties": {
                "gateway": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Data gateway (typically the same as cluster.network.data_gateway)."
                },
                "ip": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Data IP (Table 2: <ndN_data_ip>)."
                },
                "mask": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_netmask",
                    "description": "Prefix length for the data subnet (matches cluster.network.data_subnet)."
                },
                "vlan": {
                    "default": null,
                    "description": "VLAN ID if the data link is trunked. null for access mode.",
                    "oneOf": [
                        {
                            "$ref": "./shared.json#/definitions/vlan_id"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "gateway",
                "ip",
                "mask"
            ],
            "type": "object"
        },
        "cluster.nodes.node.mgmt": {
            "additionalProperties": false,
            "description": "ND-MGMT (out-of-band cluster mgmt) interface for this node.",
            "properties": {
                "gateway": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Mgmt gateway (typically the same as cluster.network.mgmt_gateway)."
                },
                "ip": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_address",
                    "description": "Management IP (Table 2: <ndN_mgmt_ip>)."
                },
                "mask": {
                    "$ref": "./shared.json#/definitions/ip/properties/ipv4_netmask",
                    "description": "Prefix length for the mgmt subnet (matches cluster.network.mgmt_subnet)."
                },
                "vlan": {
                    "default": null,
                    "description": "VLAN ID if the mgmt link is trunked. null for access mode (typical).",
                    "oneOf": [
                        {
                            "$ref": "./shared.json#/definitions/vlan_id"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "gateway",
                "ip",
                "mask"
            ],
            "type": "object"
        },
        "cluster.ntp": {
            "additionalProperties": false,
            "description": "NTP servers used by the cluster (Table 1: <ntp_server_*>). Two or more required by the MOP prerequisites.\n\nRequired Attributes:\n  * `servers`\n\nOptional Attributes:\n  * None",
            "properties": {
                "servers": {
                    "description": "At least two NTP servers are required. Each server must provide a host; preferred is optional.",
                    "items": {
                        "$ref": "#/definitions/cluster.ntp.server"
                    },
                    "minItems": 2,
                    "type": "array",
                    "uniqueItems": false
                }
            },
            "required": [
                "servers"
            ],
            "type": "object"
        },
        "cluster.ntp.server": {
            "additionalProperties": false,
            "description": "Configuration for a single NTP server.\n\nRequired Attributes:\n  * `host`\n\nOptional Attributes:\n  * `preferred` - Default is `false`.",
            "properties": {
                "host": {
                    "$ref": "./shared.json#/definitions/hostname_or_ipv4",
                    "description": "NTP server (IP literal preferred; troubleshooting log notes verifyremoteservices fails when DNS can't resolve hostnames)."
                },
                "preferred": {
                    "default": false,
                    "description": "Marks the preferred peer. Exactly one server is typically marked preferred.",
                    "type": "boolean"
                }
            },
            "required": [
                "host"
            ],
            "type": "object"
        },
        "cluster.runtime": {
            "additionalProperties": false,
            "description": "Operator-side defaults consumed by Phase 1 Python automation (scripts/main.py). Phase 2 mirrors these as Ansible role defaults.\n\nRequired Attributes:\n  * None\n\nOptional Attributes:\n  * `ca_bundle` - Default is `null`.\n  * `cluster_bringup_timeout_s` - Default is `3600`.\n  * `state_dir` - Default is `state/`.\n  * `verify_tls` - Default is `true`.",
            "properties": {
                "ca_bundle": {
                    "default": null,
                    "description": "Path to a PEM CA bundle for TLS verification. null falls back to system trust.",
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "cluster_bringup_timeout_s": {
                    "default": 3600,
                    "description": "Total budget for cluster bringup poll. CVD says ~30 min; default 60 min.",
                    "maximum": 14400,
                    "minimum": 600,
                    "type": "integer"
                },
                "state_dir": {
                    "default": "state/",
                    "minLength": 1,
                    "type": "string"
                },
                "verify_tls": {
                    "default": true,
                    "description": "Set false only in labs with self-signed certs and no CA bundle. Logs a warning.",
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "fabrics": {
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "classicLan"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "properties": {
                            "fabric_settings": {
                                "$ref": "#/definitions/fabrics.fabric_settings.classic_lan_fabric_settings"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": [
                                    "vxlanEbgp",
                                    "vxlanIbgp"
                                ]
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "properties": {
                            "fabric_settings": {
                                "$ref": "#/definitions/fabrics.fabric_settings.vxlan_fabric_settings"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "aiRouted"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "properties": {
                            "fabric_settings": {
                                "$ref": "#/definitions/fabrics.fabric_settings.ai_routed_fabric_settings"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "aiVxlanEvpn"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "properties": {
                            "fabric_settings": {
                                "$ref": "#/definitions/fabrics.fabric_settings.ai_vxlan_evpn_fabric_settings"
                            }
                        }
                    }
                }
            ],
            "description": "Configuration for Nexus Dashboard fabric deployment.\n\nRequired Attributes:\n  * `type`\n\nOptional Attributes:\n  * `fabric_settings`\n  * `licenseTier` - Default is `essentials`.\n  * `name`\n  * `switches`\n  * `telemetry`",
            "properties": {
                "fabric_settings": {
                    "description": "Fabric-specific settings for four fabric types. The parent fabric `type` selects which settings definition is used. Omitted optional settings use their declared defaults.\n\n`classicLan` settings:\n\nRequired Attributes:\n  * None\n\nOptional Attributes:\n  * `cdp` - Default is `false`.\n  * `coppPolicy` - Default is `manual`.\n  * `inbandManagement` - Default is `false`.\n  * `interfaceStatisticsLoadInterval` - Default is `10`.\n  * `monitoredMode` - Default is `true`.\n  * `mplsHandoff` - Default is `false`.\n  * `mplsLoopbackIdentifier` - Default is `101`.\n  * `nxapi` - Default is `false`.\n  * `performanceMonitoring` - Default is `false`.\n  * `realTimeInterfaceStatisticsCollection` - Default is `false`.\n  * `snmpTrap` - Default is `true`.\n  * `softwareUpdateMode` - Default is `false`.\n\n`vxlanIbgp` and `vxlanEbgp` settings:\n\nRequired Attributes:\n  * None\n\nOptional Attributes:\n  * `bgpAsn`\n  * `coppPolicy` - Default is `strict`.\n  * `fabricMtu` - Default is `9216`.\n  * `firstHopRedundancyProtocol` - Default is `hsrp`.\n  * `interfaceStatisticsLoadInterval` - Default is `10`.\n  * `intraFabricSubnetRange` - Default is `10.4.0.0/16`.\n  * `l2VniRange`\n  * `l3VniRange`\n  * `networkVlanRange` - Default is `2300-2999`.\n  * `nxapi` - Default is `true`.\n  * `performanceMonitoring` - Default is `true`.\n  * `snmpTrap` - Default is `true`.\n\n`aiRouted` settings:\n\nRequired Attributes:\n  * None\n\nOptional Attributes:\n  * `coppPolicy` - Default is `strict`.\n  * `interfaceStatisticsLoadInterval` - Default is `10`.\n  * `nxapi` - Default is `true`.\n  * `performanceMonitoring` - Default is `true`.\n  * `snmpTrap` - Default is `true`.\n  * `softwareUpdateMode` - Default is `false`.\n\n`aiVxlanEvpn` settings:\n\nRequired Attributes:\n  * None\n\nOptional Attributes:\n  * `bgpAsn`\n  * `coppPolicy` - Default is `strict`.\n  * `fabricMtu` - Default is `9216`.\n  * `nxapi` - Default is `true`.\n  * `performanceMonitoring` - Default is `true`.\n  * `snmpTrap` - Default is `true`.\n  * `softwareUpdateMode` - Default is `false`.",
                    "type": "object"
                },
                "licenseTier": {
                    "default": "essentials",
                    "description": "License tier for the fabric",
                    "enum": [
                        "advantage",
                        "essentials",
                        "premier"
                    ],
                    "example": "essentials",
                    "title": "License Tier",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the fabric. Only alphanumeric, underscore, and hyphen characters are allowed; must start and end with an alphanumeric character, and cannot be numbers alone.",
                    "examples": [
                        "ai-backend",
                        "production-fabric"
                    ],
                    "maxLength": 64,
                    "minLength": 1,
                    "not": {
                        "pattern": "^[0-9]+$"
                    },
                    "pattern": "^(?=.{1,64}$)[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?$",
                    "title": "Fabric Name",
                    "type": "string"
                },
                "switches": {
                    "$ref": "#/definitions/fabrics.switches"
                },
                "telemetry": {
                    "$ref": "#/definitions/fabrics.telemetry_settings",
                    "description": "Telemetry collection and reporting settings"
                },
                "type": {
                    "description": "Type of fabric to deploy.",
                    "enum": [
                        "aiRouted",
                        "aiVxlanEvpn",
                        "classicLan",
                        "vxlanEbgp",
                        "vxlanIbgp"
                    ],
                    "example": "classicLan",
                    "title": "Fabric Type",
                    "type": "string"
                }
            },
            "required": [
                "type"
            ],
            "title": "Nexus Dashboard Fabric Configuration",
            "type": "object"
        },
        "fabrics.fabric_settings.ai_routed_fabric_settings": {
            "additionalProperties": true,
            "description": "Settings specific to AI Routed fabric type",
            "properties": {
                "coppPolicy": {
                    "default": "strict",
                    "description": "Fabric-wide Control Plane Policing policy",
                    "enum": [
                        "dense",
                        "lenient",
                        "manual",
                        "moderate",
                        "strict"
                    ],
                    "example": "strict",
                    "title": "COPP Policy",
                    "type": "string"
                },
                "interfaceStatisticsLoadInterval": {
                    "default": 10,
                    "description": "Interface statistics polling interval in seconds",
                    "example": 10,
                    "maximum": 300,
                    "minimum": 5,
                    "title": "Interface Statistics Load Interval",
                    "type": "integer"
                },
                "nxapi": {
                    "default": true,
                    "description": "Enable NX-API over HTTPS",
                    "example": true,
                    "title": "NX-API",
                    "type": "boolean"
                },
                "performanceMonitoring": {
                    "default": true,
                    "description": "Enable periodic SNMP polling for metrics",
                    "example": true,
                    "title": "Performance Monitoring",
                    "type": "boolean"
                },
                "snmpTrap": {
                    "default": true,
                    "description": "Configure Nexus Dashboard as SNMP trap receiver",
                    "example": true,
                    "title": "SNMP Trap",
                    "type": "boolean"
                },
                "softwareUpdateMode": {
                    "default": false,
                    "description": "If enabled, Nexus Dashboard can push software updates to fabric devices",
                    "example": false,
                    "title": "Enable Fabric Software Update",
                    "type": "boolean"
                }
            },
            "title": "AI Routed Fabric Settings",
            "type": "object"
        },
        "fabrics.fabric_settings.ai_vxlan_evpn_fabric_settings": {
            "additionalProperties": true,
            "description": "Settings specific to AI VXLAN EVPN fabric type",
            "properties": {
                "bgpAsn": {
                    "description": "BGP Autonomous System Number",
                    "example": "65000",
                    "title": "BGP ASN",
                    "type": [
                        "integer",
                        "string"
                    ]
                },
                "coppPolicy": {
                    "default": "strict",
                    "description": "Fabric-wide Control Plane Policing policy",
                    "enum": [
                        "dense",
                        "lenient",
                        "manual",
                        "moderate",
                        "strict"
                    ],
                    "example": "strict",
                    "title": "COPP Policy",
                    "type": "string"
                },
                "fabricMtu": {
                    "default": 9216,
                    "description": "Maximum Transmission Unit for fabric",
                    "example": 9216,
                    "maximum": 9216,
                    "minimum": 1500,
                    "title": "Fabric MTU",
                    "type": "integer"
                },
                "nxapi": {
                    "default": true,
                    "description": "Enable NX-API over HTTPS",
                    "example": true,
                    "title": "NX-API",
                    "type": "boolean"
                },
                "performanceMonitoring": {
                    "default": true,
                    "description": "Enable periodic SNMP polling for metrics",
                    "example": true,
                    "title": "Performance Monitoring",
                    "type": "boolean"
                },
                "snmpTrap": {
                    "default": true,
                    "description": "Configure Nexus Dashboard as SNMP trap receiver",
                    "example": true,
                    "title": "SNMP Trap",
                    "type": "boolean"
                },
                "softwareUpdateMode": {
                    "default": false,
                    "description": "If enabled, Nexus Dashboard can push software updates to fabric devices",
                    "example": false,
                    "title": "Enable Fabric Software Update",
                    "type": "boolean"
                }
            },
            "title": "AI VXLAN EVPN Fabric Settings",
            "type": "object"
        },
        "fabrics.fabric_settings.classic_lan_fabric_settings": {
            "additionalProperties": true,
            "description": "Settings specific to classic-lan fabric type",
            "properties": {
                "cdp": {
                    "default": false,
                    "description": "Enable CDP on management interface",
                    "example": false,
                    "title": "CDP",
                    "type": "boolean"
                },
                "coppPolicy": {
                    "default": "manual",
                    "description": "Fabric-wide Control Plane Policing policy",
                    "enum": [
                        "dense",
                        "lenient",
                        "manual",
                        "moderate",
                        "strict"
                    ],
                    "example": "manual",
                    "title": "COPP Policy",
                    "type": "string"
                },
                "inbandManagement": {
                    "default": false,
                    "description": "Enable inband management for the fabric (use fabric data network for management traffic)",
