# Copy to /etc/aipod/appliance.env (mode 0600) and run: sudo aipod-config --env-file /etc/aipod/appliance.env
# Lists accept commas or spaces. Password values are removed from /etc/aipod/appliance.env after use.
HOSTNAME=aipod-automation
DOMAIN=example.com
IP_SOURCE=STATIC
IP_ADDRESS=192.0.2.10
PREFIX=24
GATEWAY=192.0.2.1
DNS_SERVERS=192.0.2.53,192.0.2.54
DNS_SEARCH=example.com
NTP_SERVERS=0.pool.ntp.org,1.pool.ntp.org
TIMEZONE=Etc/UTC
ADMIN_PASSWORD=
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=
